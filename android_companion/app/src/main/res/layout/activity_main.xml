<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060A11"
    android:padding="16dp">

    <!-- Header SAO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YUI MHCP-0001"
        android:textColor="#FF79C6"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Android Companion &amp; Call Shield"
        android:textColor="#8BE9FD"
        android:textSize="12sp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp" />

    <!-- Configuración URL de Nube -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/etBackendUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="https://web-production-7eeaa.up.railway.app"
            android:textColor="#F8F8F2"
            android:textColorHint="#6272A4"
            android:background="#151922"
            android:padding="12dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSaveUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Guardar"
            app:backgroundTint="#BD93F9"
            android:textColor="#060A11"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Botones de Control Móvil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Activar Burbuja"
            app:backgroundTint="#FF79C6"
            android:textColor="#060A11"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnSyncContacts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sincronizar Contactos"
            app:backgroundTint="#50FA7B"
            android:textColor="#060A11"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Estado -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sistema listo. Toca Activar Burbuja para tener a Yui flotando siempre."
        android:textColor="#50FA7B"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <!-- WebView SAO Embebido -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#060A11" />

</LinearLayout>
