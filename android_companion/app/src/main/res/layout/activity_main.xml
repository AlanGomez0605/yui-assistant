<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060A11">

    <!-- Barra Superior Compacta SAO (Controles Nativos) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#0B1320"
        android:paddingHorizontal="10dp"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌸 YUI"
            android:textColor="#FF79C6"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnStartOverlay"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Burbuja"
            android:textSize="11sp"
            android:padding="0dp"
            app:backgroundTint="#FF79C6"
            android:textColor="#060A11"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSyncContacts"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="Contactos"
            android:textSize="11sp"
            android:padding="0dp"
            app:backgroundTint="#50FA7B"
            android:textColor="#060A11"
            android:textStyle="bold"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnToggleSettings"
            android:layout_width="38dp"
            android:layout_height="36dp"
            android:text="⚙"
            android:textSize="13sp"
            android:padding="0dp"
            app:backgroundTint="#282A36"
            android:textColor="#8BE9FD" />
    </LinearLayout>

    <!-- Panel Desplegable de Configuración URL (Oculto por defecto) -->
    <LinearLayout
        android:id="@+id/panelSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#151922"
        android:padding="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etBackendUrl"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:hint="https://web-production-7eeaa.up.railway.app"
            android:textColor="#F8F8F2"
            android:textColorHint="#6272A4"
            android:background="#060A11"
            android:paddingHorizontal="10dp"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnSaveUrl"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Guardar"
            android:textSize="11sp"
            app:backgroundTint="#BD93F9"
            android:textColor="#060A11"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <!-- Estado Rápido -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Yui SAO lista."
        android:textColor="#8BE9FD"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingVertical="2dp"
        android:background="#060A11" />

    <!-- WebView SAO Full Screen -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#060A11" />

</LinearLayout>
