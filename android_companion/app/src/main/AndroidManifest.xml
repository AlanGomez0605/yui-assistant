<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.yui.assistant">

    <!-- Conectividad a la Nube -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Overlay Flotante sobre otras aplicaciones (HUD de Yui) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Cuentas de Google para manipulación y acceso de Yui -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <!-- Acceso a Contactos para sincronización con MongoDB Atlas -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />

    <!-- Acceso a Calendario de Google (Lectura y Creación de Recordatorios) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Control de Alarmas y Temporizadores del Teléfono & Recordatorios Autónomos -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Detección y Gestión Inteligente de Llamadas (Filtro 30-40s) -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- Audio y Micrófono para comandos de voz directos -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="Yui SAO"
        android:supportsRtl="true"
        android:theme="@style/Theme.YuiAssistant"
        android:usesCleartextTraffic="true">

        <!-- Pantalla Principal de Configuración y Permisos -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.YuiAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Diálogo Rápido de Voz Flotante -->
        <activity
            android:name=".VoiceQuickDialogActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Servicio de Avatar Flotante 2D y HUD SAO (SYSTEM_ALERT_WINDOW) -->
        <service
            android:name=".FloatingOverlayService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating SAO HUD for Yui Assistant" />
        </service>

        <!-- Receptor de Recordatorios Autónomos Exactos -->
        <receiver
            android:name=".AutonomousReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Receptor de Cambio de Conectividad (Auto-Sync Queue) -->
        <receiver
            android:name=".NetworkChangeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Receptor de Llamadas Entrantes (Filtro 5s para desconocidos) -->
        <receiver
            android:name=".CallInterceptorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Servicio de Sincronización de Recordatorios en Segundo Plano -->
        <!-- Conecta por WebSocket al backend para recibir recordatorios en tiempo real -->
        <!-- Si el WS falla, hace poll HTTP cada 60s como respaldo -->
        <service
            android:name=".YuiReminderSyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Servicio de Accesibilidad para Control y Navegación del Dispositivo -->
        <service
            android:name=".YuiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
