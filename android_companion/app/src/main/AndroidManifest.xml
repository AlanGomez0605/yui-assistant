<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.yui.assistant">

    <!-- Chat con Yui (WebView hacia el backend HTTPS) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Filtro de llamadas: comparar con la agenda y rechazar desconocidos -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="Yui SAO"
        android:supportsRtl="true"
        android:theme="@style/Theme.YuiAssistant"
        android:usesCleartextTraffic="false">

        <!-- Pantalla principal: chat y botón del filtro de llamadas -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.YuiAssistant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Filtro oficial de llamadas (Android 10+, rol ROLE_CALL_SCREENING) -->
        <service
            android:name=".YuiCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Respaldo del filtro de llamadas (Android 9 o sin el rol de filtro) -->
        <receiver
            android:name=".CallInterceptorReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <!-- Filtro de llamadas de WhatsApp (Accesibilidad) -->
        <service
            android:name=".YuiAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
