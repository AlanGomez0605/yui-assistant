# ==========================================
# PROYECTO YUI - CONFIGURACIÓN DE ENTORNO
# ==========================================

# 1. Clave de API de Google Gemini (Obtén la tuya gratis en: https://aistudio.google.com/)
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Configuración del Servidor
HOST=0.0.0.0
PORT=8000
DEBUG=False
API_TOKEN=
CORS_ORIGINS=

# 3. Identidad del Usuario Principal
OWNER_NAME=Alan Jahir
OWNER_NICKNAME=Alan
ASSISTANT_NAME=Yui

# 4. Base de Datos
MONGODB_URI=tu_mongodb_uri
MONGODB_DB_NAME=yui_cloud_memory

# 5. Configuración de Voz (Edge-TTS)
# Voces recomendadas en español: es-MX-DaliaNeural (Cálida/Femenina), es-ES-ElviraNeural, etc.
TTS_VOICE=es-MX-DaliaNeural
